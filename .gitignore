# Build directory (CMake build artifacts)
/build/

# Python venv for the offline GLSL validator (moderngl)
/.venv-tools/

# Regenerated binaries (produced by `python configure.py build`)
/bin/lt64r
/bin/lt64d
/bin/lt64
/bin/lt64rm
/bin/libphx64r.so
/bin/libphx64d.so
/bin/libphx64.so
/bin/libphx64d.so.*

# Precompiled headers / object caches
*.o
*.obj
*.gcda
*.gcno

# Editor / OS cruft
*.swp
*~
.DS_Store

# Runtime artifacts
log/settings_dump.txt
dump_*.png
screenshot/

# The old Limit Theory warp/wormhole source, dropped in for reference while
# the jumpgates were ported. Not part of the build.
/Warping/
# The old Limit Theory source, dropped in for reference while the jumpgates
# and the universe generator were ported. Not part of the build.
/UniverseGen/

# The old Limit Theory's market UI and the full old source tree, dropped in
# for reference while the market was rebuilt. Not part of the build.
/Market/
/liblt/

# Screenshots the app saves during a session.
/script/Screenshot_*.png
